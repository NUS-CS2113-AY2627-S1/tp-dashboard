mit":false,"messageTitle":"Update DeveloperGuide.md","messageBody":"","tags":["v1.0"],"fileTypesAndContributionMap":{"docs":{"insertions":4,"deletions":0}}}]}],"zechby":[{"date":"2026-09-20T00:00:00","commitResults":[{"hash":"dd58bce3d2f568ce67e4442e7be1c7233c98158b","isMergeCommit":false,"messageTitle":"implemented addproduct and list product as well as the basic ui infrastructure","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":516,"deletions":11},"test-code":{"insertions":336,"deletions":0}}}]},{"date":"2026-10-04T00:00:00","commitResults":[{"hash":"07b76bbb59376c995bf3f20ae65bbe1b53f99d99","isMergeCommit":false,"messageTitle":"Update AboutUs.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":0}}},{"hash":"3d370c241d8443fa01847efe4a739bb5daad6652","isMergeCommit":true,"messageTitle":"Merge pull request #35 from zechby/master","messageBody":"Update AboutUs.md to add my name","fileTypesAndContributionMap":{}}]},{"date":"2026-10-12T00:00:00","commitResults":[{"hash":"0c17aa7f43570a25cfe16851fb1dd5f60163da27","isMergeCommit":true,"messageTitle":"Merge pull request #37 from AngBryan/master","messageBody":"Refactor Stock Commands + Add JUnit test","fileTypesAndContributionMap":{}},{"hash":"4617ee50a535f562505bfccd68284996be73318c","isMergeCommit":true,"messageTitle":"Merge pull request #38 from JonasLow/branch-assertions","messageBody":"Updated UG with Section 3 - Orders","fileTypesAndContributionMap":{}}]},{"date":"2026-10-14T00:00:00","commitResults":[{"hash":"b37a799e59e6bc234e48f81133cf610a9b1e1ef6","isMergeCommit":false,"messageTitle":"Add assertions and logging to the product catalogue","messageBody":"The parser already rejects empty names and negative prices, and stock\nand order commands check quantities before changing stock. Assertions\nin Product and ProductList make those assumptions explicit, so a caller\nthat skips validation fails at the source instead of corrupting data.\n\nAddProductCommand logs adds and rejected duplicates at FINE. The default\nconsole handler only prints INFO and above, so these messages stay out\nof the user\u0027s CLI output.\n\nNew ProductTest cases check that the assertions fire, since Gradle runs\ntests with assertions enabled.\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\nClaude-Session: https://claude.ai/code/session_01KdnUfZe1pDn9aqbLV2sg4e\n","fileTypesAndContributionMap":{"functional-code":{"insertions":39,"deletions":1},"test-code":{"insertions":30,"deletions":0}}},{"hash":"ec448fef1bdbc9c44ad911dce2f6d96519169cb3","isMergeCommit":false,"messageTitle":"Add product catalogue section to the User Guide","messageBody":"The User Guide covered orders, sales and expenses but not products,\neven though every order and stock record depends on a product existing\nfirst. Document product add and product list as section 1, matching the\nnumbered layout of the other sections, including the p/PRODUCT a/AMOUNT\nformat, case-insensitive name matching and the price rules enforced by\nthe parser.\n\nAlso record AI assistance in the Developer Guide acknowledgements, as\nthe course requires for AI-assisted work.\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\nClaude-Session: https://claude.ai/code/session_01KdnUfZe1pDn9aqbLV2sg4e\n","fileTypesAndContributionMap":{"docs":{"insertions":68,"deletions":0}}},{"hash":"77b54c396b8a9d7d855528378001865dc84bb56a","isMergeCommit":true,"messageTitle":"Merge pull request #46 from AngBryan/master","messageBody":"Remove price in stock add command and add assertions, exceptions and logging","fileTypesAndContributionMap":{}}]}],"JonasLow":[{"date":"2026-09-23T00:00:00","commitResults":[{"hash":"0d6d30c3a50c054437ec0b40b1c54d63bcf3ab9a","isMergeCommit":true,"messageTitle":"Merge pull request #12 from zechby/branch-product-catalogue","messageBody":"implemented addproduct and list product and the basic ui infra…","fileTypesAndContributionMap":{}},{"hash":"d40a7