sertions":16,"deletions":34}}},{"hash":"b14b3e6052fe5840c9bc15486df99061eb0b323a","isMergeCommit":false,"messageTitle":"Checkstyle compliance","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":5,"deletions":3}}},{"hash":"9b1e532aead164f2a56f5544b80dd8615427d0ad","isMergeCommit":false,"messageTitle":"created board.ensureSafeFirstClick(row, col);","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":22,"deletions":24}}},{"hash":"29e06b0ca3ae1b1dffb06b01a710854108189abd","isMergeCommit":false,"messageTitle":"Cleaned first move implementation","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":11,"deletions":25}}},{"hash":"b045427d675d79e5b2ebc38b5bba6425c64ac6ee","isMergeCommit":true,"messageTitle":"Merge pull request #24 from M4ttL4m/branch-improved_floodfill","messageBody":"resolve empty-cell expansion issue in RevealCommand and improved Board floodfill","fileTypesAndContributionMap":{}},{"hash":"8a402b294985ca527996e76ff55cd1bf2b51a22d","isMergeCommit":false,"messageTitle":"Refurbished safe first move to Minesweeper reveal","messageBody":"The first reveal of a game could hit a mine, unlike classic\nMinesweeper. Add Board.ensureSafeFirstClick(row, col), which moves\nany mines in the clicked cell and its 8 neighbours to random cells\noutside that area, then recalculates adjacency counts. The clicked\ncell then always has 0 adjacent mines, so the existing flood fill\nopens a blank region. The total mine count is unchanged.\n\n- RevealCommand calls it after the flagged-cell check, so revealing\n  a flagged cell does not use up the protection.\n- Board tracks isFirstMove; NewGameCommand now uses the new\n  Board.copyStateFrom() so the protection resets for each new game\n  (previously only the grid was replaced, so it would have stayed\n  off after the first game).\n- Assertions guard the bounds, board size, mine-count invariant and\n  the safe-click postcondition.\n- Tests: BoardTest and RevealCommandTest cover corner/edge/middle\n  clicks, mine count, adjacency counts, double calls, flagged first\n  click and new game. RevealCommandTest.createEmptyBoard() now\n  really clears mines and uses up the protection, so tests that\n  place mines by hand stay deterministic.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":78,"deletions":13},"test-code":{"insertions":182,"deletions":5}}},{"hash":"3ae2b34d0b6a38b40185175681e64bedcf32ee4b","isMergeCommit":true,"messageTitle":"Merge pull request #28 from M4ttL4m/branch-Safe-First-Click","messageBody":"Refurbished safe first move to Minesweeper reveal","fileTypesAndContributionMap":{}}]}],"zzzwun":[{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"012113cae6210b5f591c145fbd4d8bb1dd64d3f6","isMergeCommit":false,"messageTitle":"Update AboutUs.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":4,"deletions":7}}},{"hash":"f4473e957f45217dfab6c114234510ec49735626","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into ZheWen-AboutUs","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"e69aa3d736f2ef962f15bc17c584b54457bdfe21","isMergeCommit":true,"messageTitle":"Merge pull request #2 from zzzwun/ZheWen-AboutUs","messageBody":"Update AboutUs.md","fileTypesAndContributionMap":{}}]},{"date":"2026-10-09T00:00:00","commitResults":[{"hash":"d919d53cf752c31dbe6aabff510a7622d1fac1fb","isMergeCommit":false,"messageTitle":"Added FlagCommand class","messageBody":"-extends Command\n","fileTypesAndContributionMap":{"functional-code":{"insertions":25,"deletions":0}}},{"hash":"b00d3ff33348ec89b451d42c12cfaf7031539bbf","isMergeCommit":true,"messageTitle":"Merge pull request #15 from zzzwun/start-flagging-and-victory","messageBody":"Added FlagCommand class","fileTypesAndContributionMap":{}},{"hash":"c536a8abde520011c2225601cd9c211c48ed8bb0","isMergeCommit":false,"messageTitle":"- Added Unflag and Junit test","messageBody":"- todo: add victory check\n","fileTyp