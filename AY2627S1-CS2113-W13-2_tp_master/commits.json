 request #3 from naieel04/Ian-AboutUs","messageBody":"Updaetd AboutUs ","fileTypesAndContributionMap":{}}]}],"nabijonzzz":[{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"e97430e5cd76f3f0a131a9d5cd6826473dbd9d43","isMergeCommit":false,"messageTitle":"Add Nabijon to AboutUs","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":0}}}]},{"date":"2026-10-07T00:00:00","commitResults":[{"hash":"93130993530cce9e77388cc7df1978966ee82359","isMergeCommit":false,"messageTitle":"Add deposit and withdraw commands with core structure","messageBody":"Implement deposit (#8) and withdraw (#9). These are the first features that create transactions, so add the shared base they need: Transaction, TransactionList, Command, Parser, Ui and FinNusException. Other commands (balance, recent, delete, help) can be added as new Command subclasses. Parser accepts parameters in any order, rejects invalid amounts (negative, zero, more than 2 decimals, NaN, scientific notation) and requires a description for withdraw. Add JUnit tests for parsing, commands and Transaction formatting.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":416,"deletions":11},"test-code":{"insertions":172,"deletions":12}}}]},{"date":"2026-10-09T00:00:00","commitResults":[{"hash":"8dd358993af96157db0ee932df21319daa5e7b3d","isMergeCommit":false,"messageTitle":"Use BigDecimal for amounts and add no-description deposit constructor","messageBody":"double cannot represent most decimal values exactly (e.g. 0.1 + 0.2 \u003d 0.30000000000000004), so balances would drift and comparisons could be wrong. BigDecimal keeps amounts exact. Add DepositCommand(BigDecimal) for deposits without a description, as suggested in review. Enable assertions for the Gradle run task.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":39,"deletions":18},"other":{"insertions":2,"deletions":0},"test-code":{"insertions":37,"deletions":12}}},{"hash":"c1925a79cec3390ec12e1f93d37b9e55b9019f15","isMergeCommit":false,"messageTitle":"Add deposit and withdraw sections to User Guide","messageBody":"Document the format, amount rules (positive, at most 2 decimal places, max 1,000,000), optional vs required description, and that parameters can be given in any order. Include examples and expected output so users know what to expect. Replace the template todo example.\n","fileTypesAndContributionMap":{"docs":{"insertions":57,"deletions":14}}}]}],"chancheese":[{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"b7b6780967ec5a849fc42ece7762fc6f2923eac9","isMergeCommit":false,"messageTitle":"Add my own About Us","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":5}}},{"hash":"59962eb92fb46d567e2d39c867ef13c58f55f218","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into chancheese-AboutUs","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"8f39b1fe8af8c9f175762e594105598956972bb6","isMergeCommit":true,"messageTitle":"Merge pull request #4 from chancheese/chancheese-AboutUs","messageBody":"Add my own About Us","fileTypesAndContributionMap":{}}]},{"date":"2026-10-13T00:00:00","commitResults":[{"hash":"975b9d01feff9a78ca6a11cb22edf394d7592e31","isMergeCommit":true,"messageTitle":"Merge pull request #21 from lololol8484/master","messageBody":"Implement delete feature","fileTypesAndContributionMap":{}},{"hash":"aab0caa7d9993f83e2ae9105bfbe3c1105b2d369","isMergeCommit":false,"messageTitle":"Add opening command to set starting balance","messageBody":"Store the opening balance on TransactionList so it is not a transaction\nand does not affect recent or delete. Allow 0 so it can be reset.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":116,"deletions":5},"docs":{"insertions":25,"deletions":0},"test-code":{"insertions":121,"deletions":0}}},{"hash":"2689db7c884497075700f886a7c2c960590f1967","isMergeCommit":false,"messageTitle":"Add CurrencyRates to store exchange rates","messageBody":"Rates are entered by the user as 1 SGD \u003d RATE units, so FinNUS works\noffline. TransactionList holds them so commands can reach them without\nchanging Command.execute.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":68,"deletions":0}}},{"hash":"f5bcb6bfe5f05e4b3494ae0407d698d3097b5004","isMergeCommit":false,"messageTitle":"Add rate command to set and list exchange rates","messageBody":"rate JPY 110 sets 1 SGD \u003d 110 JPY; rate alone lists all rates.\nCurrency codes are checked against java.util.Currency to catch typos.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":151,"deletions":0}}},{"hash":"0f8b930404ab4323f9fe74f0f13de8fb463723ee","isMergeCommit":false,"messageTitle":"Add tests for currency rates and rate command","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":170,"deletions":0}}},{"hash":"3ca1c79fc200aed0e5a1b5fcbe1c3ae743e80478","isMergeCommit":false,"messageTitle":"Document rate command in user guide","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":33,"deletions":0}}},{"hash":"9794c210a7037c95fc6f829b66956633f5dfb550","isMergeCommit":false,"messageTitle":"Split currency code assert for clearer messages","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":1}}},{"hash":"e074779ebd1fb7a2b5aca5d2d4f142d277bafa31","isMergeCommit":true,"messageTitle":"Merge pull request #22 from chancheese/12-set-opening-balance","messageBody":"Add opening command to set starting balance","fileTypesAndContributionMap":{}},{"hash":"9d35d6bd152ee2f89e25082ba1be117a77105605","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into 13-currency-rates","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"57bc4a3b972c50971d14e70bad2b9ffdc1710779","isMergeCommit":true,"messageTitle":"Merge pull request #23 from chancheese/13-currency-rates","messageBody":"Add currency rates ","fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionM